#!/usr/bin/env bash
# stingy setup — register skills with Claude Code
set -e

STINGY_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_DIR="$HOME/.claude/skills"
SKILLS=(stingy-slim stingy-audit stingy-route stingy-burn stingy-compare stingy-budget stingy-ration stingy-guard)

# ─── Version ─────────────────────────────────────────────────
if [ "${1:-}" = "--version" ]; then
  version="$(cat "$STINGY_DIR/VERSION" 2>/dev/null || echo "unknown")"
  echo "stingy v$version"
  exit 0
fi

# ─── Update ──────────────────────────────────────────────────
if [ "${1:-}" = "--update" ]; then
  echo "stingy — updating"
  echo ""
  if git -C "$STINGY_DIR" pull --ff-only; then
    echo ""
    echo "Update complete. Re-running setup..."
    echo ""
    exec "$0" --yes
  else
    echo ""
    echo "  ⚠️  Update failed — not a git repo or fast-forward not possible."
    echo "     Update manually: cd $STINGY_DIR && git pull"
    exit 1
  fi
fi

# ─── Uninstall ───────────────────────────────────────────────
if [ "${1:-}" = "--uninstall" ]; then
  echo "stingy — uninstalling"
  echo ""
  for skill in "${SKILLS[@]}"; do
    target="$SKILLS_DIR/$skill"
    if [ -d "$target" ] || [ -L "$target" ]; then
      rm -rf "$target"
      echo "  ❌ Removed $target"
    fi
  done
  # Remove commands
  for cmd_file in "$STINGY_DIR"/commands/*.md; do
    [ -f "$cmd_file" ] || continue
    cmd_name=$(basename "$cmd_file" .md)
    target="$HOME/.claude/commands/$cmd_name.md"
    if [ -L "$target" ]; then
      rm "$target"
      echo "  ❌ Removed $target"
    fi
  done
  echo ""
  echo "Skills and commands removed"
  echo ""
  if [ -d "$HOME/.stingy" ]; then
    read -r -p "Also remove data directory ~/.stingy/? [y/N] " response
    if [[ "$response" =~ ^[Yy]$ ]]; then
      rm -rf "$HOME/.stingy"
      echo "  ❌ Removed ~/.stingy/"
    else
      echo "  Kept ~/.stingy/ (budgets and usage logs preserved)"
    fi
  fi
  echo ""
  echo "Uninstall complete. Restart Claude Code to take effect."
  exit 0
fi

# ─── Install ─────────────────────────────────────────────────
echo "stingy — token efficiency toolkit for Claude Code"
echo "================================================="
echo ""
echo "This will:"
echo "  • Create symlinks in $SKILLS_DIR/ for ${#SKILLS[@]} skills"
echo "  • Install /stingy:maintenance command in ~/.claude/commands/"
echo "  • Create a data directory at ~/.stingy/ (budgets, usage logs)"
echo "  • No other files will be modified"
echo ""

# Confirmation prompt (skip with --yes or in non-interactive mode)
if [ "${1:-}" != "--yes" ] && [ -t 0 ]; then
  read -r -p "Continue? [Y/n] " response
  if [[ "$response" =~ ^[Nn]$ ]]; then
    echo "Aborted."
    exit 0
  fi
fi

# Ensure skills directory exists
mkdir -p "$SKILLS_DIR"

echo ""
for skill in "${SKILLS[@]}"; do
  target="$SKILLS_DIR/$skill"

  # Safety: only remove if it's a symlink or a stingy-managed directory
  if [ -L "$target" ]; then
    rm "$target"
  elif [ -d "$target" ]; then
    # Check if this looks like a stingy skill (has symlink to our SKILL.md)
    if [ -L "$target/SKILL.md" ]; then
      rm -rf "$target"
    else
      echo "  ⚠️  Skipping $skill — $target exists and wasn't created by stingy"
      echo "     Remove it manually if you want stingy to manage this skill."
      continue
    fi
  fi

  # Create directory with symlinked SKILL.md
  mkdir -p "$target"
  ln -sf "$STINGY_DIR/$skill/SKILL.md" "$target/SKILL.md"

  # Link bin/ if it exists
  if [ -d "$STINGY_DIR/$skill/bin" ]; then
    ln -sf "$STINGY_DIR/$skill/bin" "$target/bin"
  fi

  echo "  ✅ /$skill"
done

# ─── Install commands ────────────────────────────────────────
COMMANDS_DIR="$HOME/.claude/commands"
mkdir -p "$COMMANDS_DIR"

for cmd_file in "$STINGY_DIR"/commands/*.md; do
  [ -f "$cmd_file" ] || continue
  cmd_name=$(basename "$cmd_file" .md)
  # Extract the name field from YAML frontmatter for display
  display_name=$(sed -n 's/^name: *//p' "$cmd_file" 2>/dev/null | head -1)
  display_name="${display_name:-$cmd_name}"
  target="$COMMANDS_DIR/$cmd_name.md"
  if [ -L "$target" ]; then
    rm "$target"
  fi
  ln -sf "$cmd_file" "$target"
  echo "  ✅ /$display_name"
done

# ─── Verify symlinks ─────────────────────────────────────────
for skill in "${SKILLS[@]}"; do
  target="$SKILLS_DIR/$skill"
  if [ ! -f "$target/SKILL.md" ]; then
    echo "  ⚠️  Warning: $skill symlink appears broken — $target/SKILL.md not found"
  fi
done

# Create stingy data directory
mkdir -p "$HOME/.stingy"

echo ""
echo "Installed ${#SKILLS[@]} skills + commands. Open Claude Code and type a command to start:"
echo ""
echo "  /stingy-slim      Find what's making your AI sessions expensive and fix it"
echo "  /stingy-audit     Check if you're wasting tokens in this session"
echo "  /stingy-route     Get the cheapest AI for any task"
echo "  /stingy-burn      See your session cost breakdown"
echo "  /stingy-compare   Compare prices across Claude, ChatGPT, Gemini, Grok"
echo "  /stingy-budget    Set a spending limit and track it"
echo "  /stingy-ration    Running low? Export your work to a cheaper AI"
echo "  /stingy-guard     Auto-warn before wasteful tool calls"
echo ""
echo "  /stingy:maintenance  Check for upstream pricing/model changes"
echo ""
echo "👉 Start here: type /stingy-slim in Claude Code to see your token footprint"
echo ""
echo "Data stored in: ~/.stingy/"
echo "To uninstall:   ./setup --uninstall"
